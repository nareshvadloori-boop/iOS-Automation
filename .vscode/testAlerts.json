{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run testAlerts1 from DemoScripts (iPhone 17 Pro Max)",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "test",
        "-scheme",
        "Lebyy",
        "-destination",
        "platform=iOS Simulator,name=iPhone 17 Pro Max",
        "-only-testing:NareshVUITests/demoUITest/testAlerts1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
